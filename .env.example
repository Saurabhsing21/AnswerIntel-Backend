# --- App ---
# development locally, production when live
APP_ENV="development"
# true = only the waitlist endpoint answers
WAITLIST_ONLY="false"
# live app URL, e.g. https://app.seenlens.com
APP_BASE_URL=
# comma-separated site URLs allowed to call the API
CORS_ORIGINS=

# --- Database (Neon) ---
# pooled URL, used by the app
DATABASE_URL=
# direct URL, used by migrations
DATABASE_URL_UNPOOLED=
# connections kept open: 4 concurrent scans x (1 + SCAN_CONCURRENCY)
DB_POOL_SIZE="20"
# extra connections allowed during bursts
DB_MAX_OVERFLOW="10"
# seconds to wait for a free connection before giving up
DB_POOL_TIMEOUT_SECONDS="10"

# --- Auth ---
# random, 32+ characters in production
JWT_SECRET_KEY=
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="30"
# Continue with Google; empty hides the button
GOOGLE_CLIENT_ID=

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# writes buyer questions
PROMPT_MODEL="openai/gpt-5.4-mini"
# reads every answer
ANALYSIS_MODEL="openai/gpt-5.4-nano"
# override a model, e.g. claude=anthropic/claude-sonnet-4.5
ENGINE_MODELS=

# --- Google AI Mode (DataForSEO) ---
# empty = engine off
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Scans ---
SCAN_CONCURRENCY="4"
PROVIDER_TIMEOUT_SECONDS="90"
PROVIDER_MAX_RETRIES="2"
PROVIDER_RETRY_DELAYS="30,120,600"
PROVIDER_MAX_PARALLEL_PER_ENGINE="2"
# per project
MAX_SCANS_PER_DAY="20"
RAW_RESPONSE_RETENTION_DAYS="730"
MAX_COMPETITORS="100"
MAX_ACTIVE_PROMPTS="700"
# all AI spend per UTC day across every workspace; 0 = no limit
DAILY_AI_BUDGET_USD="10.0"
# a workspace's monthly AI spend cap, as a share of its plan price
WORKSPACE_COST_CAP_RATIO="0.5"
# the same cap, in dollars, for plans that cost nothing
FREE_WORKSPACE_COST_CAP_USD="1.0"

# --- Jobs (Redis / Celery) ---
# empty = scans run inside the API; production needs Redis
REDIS_URL=

# --- Free website check ---
FREE_CHECK_ENABLED="false"
FREE_CHECKS_PER_DAY="100"
FREE_CHECKS_PER_CLIENT="3"
FREE_CHECK_PROMPTS="5"
FREE_CHECK_ENGINES="chatgpt_search,perplexity"

# --- Rate limits ---
RATE_LIMIT_ENABLED="true"
LOGIN_RATE_LIMIT_PER_MINUTE="5"
API_RATE_LIMIT_PER_MINUTE="100"
WAITLIST_RATE_LIMIT_PER_MINUTE="10"

# --- Email (Resend) ---
RESEND_API_KEY=
# e.g. SeenLens <reports@yourdomain>; domain verified in Resend
EMAIL_FROM=

# --- Billing (Stripe) ---
# sk_live_ in production
STRIPE_SECRET_KEY=
# whsec_ of the webhook pointing at this API
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Monitoring ---
# empty = error monitoring off
SENTRY_DSN=
