APP_ENV=development

# PostgreSQL (docker: answerintel-postgres on 5433)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/answerintel

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI gateway. Leave empty to run with the clearly labelled simulated provider.
OPENROUTER_API_KEY=
# engine_key=openrouter/model-slug, comma separated
SCAN_ENGINES=chatgpt=openai/gpt-5.4-mini,perplexity=perplexity/sonar,gemini=google/gemini-3.8-flash
PROMPT_MODEL=openai/gpt-5.4-mini
ANALYSIS_MODEL=openai/gpt-5.4-mini
SCAN_CONCURRENCY=4

# Dashboard origin(s), comma separated
CORS_ORIGINS=http://localhost:3000

# Report email delivery (Resend). Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=SeenLens <reports@seenlens.com>

# Job queue (Celery + Redis). Leave REDIS_URL empty to run scans inside the API process (local dev).
# Worker: celery -A app.worker.celery_app worker -Q scan -P threads --concurrency 4
# (-P threads: scans are I/O-bound, and the default prefork pool crashes on Python 3.14)
REDIS_URL=
# Seconds before each retry of a failed provider call (30s, 2min, 10min per PRD 59)
PROVIDER_RETRY_DELAYS=30,120,600
PROVIDER_MAX_PARALLEL_PER_ENGINE=2
MAX_SCANS_PER_DAY=20
# Hard ceilings per project; each plan sets its own lower limits (app/billing/plans.py).
MAX_ACTIVE_PROMPTS=100
MAX_COMPETITORS=10

# Rate limits (PRD 60). Counters are shared through Redis when REDIS_URL is set.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=100

# Weekly re-scans: run the scheduler too:  celery -A app.worker.celery_app beat
# Founders enable it per project with PUT /api/v1/projects/{id}/schedule (opt-in, because scans cost money).

# Sessions (PRD 6): short access token, long rotating refresh token
REFRESH_TOKEN_EXPIRE_DAYS=30

# Retention (PRD 88): raw AI answers are deleted after this many days; metrics and reports are kept.
RAW_RESPONSE_RETENTION_DAYS=365

# Billing (Stripe). Leave STRIPE_SECRET_KEY empty to disable Checkout and the Portal (trials still work).
# Test keys first (sk_test_..., whsec_... from `stripe listen`). Price ids come from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Dashboard URL that Checkout and the Portal return to.
APP_BASE_URL=http://localhost:3000

# Environment and monitoring. APP_ENV=production enforces a strong JWT_SECRET_KEY (32+ random characters)
# and, when STRIPE_SECRET_KEY is set, a STRIPE_WEBHOOK_SECRET.
APP_ENV=development
SENTRY_DSN=
