# --- App ---
# development locally, production when live
APP_ENV="development"
# true = only the waitlist endpoint answers
WAITLIST_ONLY="false"
# live app URL, e.g. https://app.seenlense.com
APP_BASE_URL=
# comma-separated site URLs allowed to call the API
CORS_ORIGINS=
# same value as the website's PROXY_SHARED_SECRET (openssl rand -hex 32); lets rate limits count per visitor
PROXY_SHARED_SECRET=

# --- Database (Neon) ---
# pooled URL, used by the app
DATABASE_URL=
# direct URL, used by migrations
DATABASE_URL_UNPOOLED=
# connections kept open: 4 concurrent scans x (1 + SCAN_CONCURRENCY)
DB_POOL_SIZE="20"
# extra connections allowed during bursts
DB_MAX_OVERFLOW="10"
# seconds to wait for a free connection before giving up
DB_POOL_TIMEOUT_SECONDS="10"

# --- Auth ---
# random, 32+ characters in production
JWT_SECRET_KEY=
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="30"
# Continue with Google; empty hides the button
GOOGLE_CLIENT_ID=

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# writes buyer questions
PROMPT_MODEL="openai/gpt-5.4-mini"
# reads every answer
ANALYSIS_MODEL="openai/gpt-5.4-nano"
# suggests 8 competitors with web search, once per new project
COMPETITOR_MODEL="openai/gpt-5.4-nano"
# override a model, e.g. claude=anthropic/claude-sonnet-4.5
ENGINE_MODELS=

# --- Google AI Mode (DataForSEO) ---
# empty = engine off
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Scans ---
SCAN_CONCURRENCY="4"
PROVIDER_TIMEOUT_SECONDS="90"
PROVIDER_MAX_RETRIES="2"
PROVIDER_RETRY_DELAYS="30,120,600"
PROVIDER_MAX_PARALLEL_PER_ENGINE="2"
# per project
MAX_SCANS_PER_DAY="20"
RAW_RESPONSE_RETENTION_DAYS="730"
MAX_COMPETITORS="100"
MAX_ACTIVE_PROMPTS="700"
# all AI spend per UTC day except the free check's; 0 = no limit
DAILY_AI_BUDGET_USD="10.0"
# the daily budget also grows by this share of every paying workspace's monthly cap
DAILY_BUDGET_SHARE_OF_PAID_CAP="0.1"
# a workspace's monthly AI spend cap, as a share of what it pays a month, on a monthly plan
WORKSPACE_COST_CAP_RATIO="0.5"
# the same on a yearly plan (what it pays a month = yearly price / 12)
WORKSPACE_COST_CAP_RATIO_YEARLY="0.6"
# the same cap, in dollars, for plans that cost nothing
FREE_WORKSPACE_COST_CAP_USD="1.0"
# the anonymous free check's own AI budget per UTC day; 0 = no limit
FREE_CHECK_DAILY_BUDGET_USD="5.0"

# comma-separated emails allowed to open the admin cost dashboard (the account's email must be verified)
ADMIN_EMAILS=

# --- Jobs (Redis / Celery) ---
# empty = scans run inside the API; production refuses to start without it (unless WAITLIST_ONLY=true)
REDIS_URL=
RUN_SCANS_IN_PROCESS="false"

# --- Free website check ---
FREE_CHECK_ENABLED="false"
FREE_CHECKS_PER_DAY="100"
FREE_CHECKS_PER_CLIENT="3"
FREE_CHECK_PROMPTS="5"
FREE_CHECK_ENGINES="chatgpt_search,perplexity"

# --- Rate limits ---
RATE_LIMIT_ENABLED="true"
LOGIN_RATE_LIMIT_PER_MINUTE="5"
API_RATE_LIMIT_PER_MINUTE="100"
WAITLIST_RATE_LIMIT_PER_MINUTE="10"

# --- Email (Resend) ---
RESEND_API_KEY=
# e.g. SeenLense <saurabh@seenlense.com>; domain verified in Resend
EMAIL_FROM=

# --- Billing (Paddle) ---
# sandbox | production. Required once a key or secret is set: the API never guesses which Paddle account to use.
PADDLE_ENV=
# Developer tools > Authentication (pdl_sdbx_apikey_... in sandbox). Powers the customer portal and plan changes.
PADDLE_API_KEY=
# Signing secret of the notification destination pointing at <API URL>/api/v1/billing/webhook (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=
# Accept webhooks only from Paddle's addresses (fetched from its /ips endpoint). The caller address comes from
# X-Forwarded-For, which uvicorn trusts only from FORWARDED_ALLOW_IPS: set that to your host's proxy, or webhooks are refused.
PADDLE_WEBHOOK_IP_CHECK=true

# --- File storage (Cloudflare R2) ---
# All four set = report PDFs are stored in the bucket; any empty = they stay in the database
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Monitoring ---
# empty = error monitoring off
SENTRY_DSN=
